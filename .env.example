# Axlori Resolve environment template. Copy to .env.local and fill in values
# from your Supabase project (Project Settings > API).
#
# Both values below are publishable by design; access is governed by Row
# Level Security on the database. The SERVICE ROLE key is NOT used by this
# app and must never be placed in any NEXT_PUBLIC_* variable or client code.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical site URL used for metadata. Set to the production domain when one
# is supplied (e.g. https://axloriresolve.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
